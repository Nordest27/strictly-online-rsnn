{
 "base": {
  "hid_e": 6,
  "hid_i": 4,
  "fan_in": 50,
  "backend": "single_threaded_cpu",
  "monitor": true,
  "monitor_every": 5000,
  "probe": {
   "moves": 5000
  },
  "ei_layers": 3,
  "network": {
   "layers": [
    {
     "to_next": {
      "mean_scale": 0.5
     },
     "to_next_i": {
      "mean_scale": 0.033
     }
    },
    {
     "to_next": {
      "mean_scale": 0.5
     },
     "to_next_i": {
      "mean_scale": 0.033
     }
    },
    {}
   ],
   "fields": {
    "conn": {
     "mean_scale": 0.5
    },
    "conn_i": {
     "mean_scale": 0.033
    }
   }
  }
 },
 "points": [
  {
   "*": {
    "_meta": {
     "variant": "prop_homeo_c"
    },
    "hidden_rule": {
     "preset": "proposed_homeostat",
     "homeostat": 1.0,
     "center_drift": true
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "drift_homeo_c"
    },
    "hidden_rule": {
     "preset": "proposed_homeostat",
     "homeostat": 1.0,
     "center_drift": true,
     "gradient": 0.0
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "grad_homeo"
    },
    "hidden_rule": {
     "preset": "gradient_only_homeostat",
     "homeostat": 1.0
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "prop_homeo_c_frozen_ro"
    },
    "hidden_rule": {
     "preset": "proposed_homeostat",
     "homeostat": 1.0,
     "center_drift": true
    },
    "train_readout": false
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "proposed"
    },
    "hidden_rule": {
     "preset": "proposed"
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "node+backprop0.3"
    },
    "hidden_rule": {
     "preset": "node_proposed",
     "backprop": 0.3
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "random"
    },
    "hidden_rule": {
     "preset": "eprop"
    }
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "random_frozen_ro"
    },
    "hidden_rule": {
     "preset": "eprop"
    },
    "train_readout": false
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "adaptive"
    },
    "hidden_rule": {
     "preset": "eprop"
    },
    "feedback_type": "adaptive",
    "optimise_feedback": true
   }
  },
  {
   "*": {
    "_meta": {
     "variant": "random+drift+homeo"
    },
    "hidden_rule": {
     "preset": "eprop_plus_proposed_homeostat",
     "drift": 0.1,
     "gradient": 0.0,
     "homeostat": 1.0,
     "center_drift": true
    }
   }
  }
 ]
}