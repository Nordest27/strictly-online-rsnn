{
 "_meta": {"variant": "input_readout", "description": "locality control: the heads read a frozen one-to-one spiking copy of the input (no recurrence, no fields); only the readout learns"},
 "toroidal": "local",
 "local": {"input_sigma_cells": 0.3, "input_sigma_ref": "source", "p_max": 1.0},
 "network": {"layers": [{"internal": {"type": "none"}}], "fields": null, "direct_readout_p": 1.0},
 "ei_layers": 1,
 "hidden_rule": {"preset": "reservoir"},
 "c_reg": 0.0001,
 "monitor": true, "monitor_every": 10000,
 "backend": "single_threaded_cpu", "seed": 0, "max_timesteps": 2000000.0, "min_episodes": 0, "repetition": 0,
 "trace_log": false, "csv_prefix": "input_readout"
}
